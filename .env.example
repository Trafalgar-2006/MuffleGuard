# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Any OpenAI-compatible provider works: OpenRouter, OpenAI, Groq, Together.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# The demo agent. A small model keeps the red-team evaluation cheap and shows
# the attack clearly; the strong model is reported alongside it.
LLM_MODEL=openai/gpt-4o-mini
LLM_MODEL_STRONG=anthropic/claude-opus-5.5

# Passcode for the public demo deployment (leave empty to disable the gate).
DEMO_PASSCODE=

# Set to 1 to expose the "Edit an entry" button, which corrupts the audit log
# on purpose to show verification catching it. Off by default: with a blank
# passcode it would be an unauthenticated route that damages data.
DEMO_TAMPER=0

# Set to 1 only when a platform proxy sits in front (Railway, Fly, Render), so
# the rate limit counts the forwarded address instead of the proxy's.
TRUST_PROXY=0

# A ceiling on live model calls per day for a public deployment. Past it the
# demo replays the recorded run instead of spending. 0 disables live calls.
DEMO_DAILY_RUNS=200
